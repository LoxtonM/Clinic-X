@model ClinicX.ViewModels.RiskSurveillanceVM

@{
    ViewData["Title"] = "ClinicX - Risk Referral List";
    ViewData["Page"] = "/ Risk / Referral List";
    ViewData["HomeBtn"] = Html.ActionLink("Home Page", "Index", "Home", new { }, new { @class = "btn btn-success m-1" });
}

@{
    ViewBag.HomeButton = new[]
    {
        Html.ActionLink("Patient Details", "PatientDetails", "Patient", new { id=Model.patient.MPI }, new { @class = "btn btn-success m-1" }),
    };
}


<div class="container">
    @if (!Model.isLive)
    {
        <h1 class="text-center redtext">NOTE: This is a test system. Work completed here will not be reflected in production.</h1>
    }

    @if (Model.message != null)
    {
        @if (Model.success)
        {
            <div class="alert alert-success d-block text-center">
                <h3>@Model.message</h3>
            </div>
        }
        else
        {
            <div class="alert alert-danger d-block text-center">
                <h3>@Model.message</h3>
            </div>
        }
    }

    <div class="row">
        <h1>Select cancer ICP to create a new risk item</h1>
    </div>
    <div class="row">
        <h4>Patient Name: @Model.patient.FIRSTNAME @Model.patient.LASTNAME</h4>
    </div>
    <div class="row">
        <h4>CGU number: <a asp-controller="Patient" asp-action="PatientDetails" asp-route-id=@Model.patient.MPI>@Model.patient.CGU_No</a></h4>
    </div>
    <div class="row">
        @if (Model.patient.DOB != null)
        {
            <h4>Date of birth: @Model.patient.DOB.Value.ToString("dd/MM/yyyy") (current age: @Model.currentAge)</h4>
        }
        else
        {
            <h4>Date of birth: Not known</h4>
        }
    </div>
    <div class="row">
        <h4>NHS No: @Model.patient.SOCIAL_SECURITY</h4>
    </div>    

    @if (Model.referralList.Count() > 0)
    {
        <table class="table" id="myTable">
            <thead>
                <tr>
                    <th></th>
                    <th>Type</th>
                    <th>Referral Date</th>     
                    <th>Referred By</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.referralList)
                {
                    <tr>
                        <td><a class="btn btn-success" asp-controller="RiskAndSurveillance" asp-action="SelectReferral" asp-route-id=@item.refid>Select</a></td>
                        <td>@item.RefDate.Value.ToString("dd/MM/yyyy")</td>                        
                        <td>@item.RefType</td>
                        <td>@item.ReferringClinician, @item.ReferringFacility</td>                                           
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <h2>There are no referrals to add a risk item to</h2>
    }
</div>